# Supabase project settings
# Copy this file to .env.local and replace every placeholder value.
# Never commit .env.local or paste real credentials into source files.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never expose a secret/service-role key in browser code.
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Flutterwave server configuration
FLUTTERWAVE_SECRET_KEY=server-only-secret
FLUTTERWAVE_SECRET_HASH=webhook-secret-hash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional ticket email delivery through Resend
RESEND_API_KEY=server-only-secret
RESEND_FROM_EMAIL=Elora Tickets <tickets@your-domain.com>
